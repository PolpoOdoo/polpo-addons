<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="qapps_uy_base_view_partner_form" model="ir.ui.view">
            <field name="name">qapps_uy_base_view_partner_form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <div class="oe_title mb24" position="inside">
                    <label
                        for="razon_social"
                        class="oe_edit_only"
                        attrs="{'invisible':[('company_type','=','person')]}"
                    />
                    <h1>
                        <field
                            name="razon_social"
                            attrs="{'invisible':[('company_type','=','person')],
                                    'required':[('company_type','=','company')]}"
                        />
                    </h1>
                </div>
                <field name="vat" position="before">
                    <field
                        name="tipo_doc"
                        attrs="{'required': [('company_type','=','company')]}"
                    />
                </field>
                <field name="vat" position="attributes">
                    <attribute name="string">Nro. Doc</attribute>
                    <attribute
                        name="attrs"
                    >{'required': [('tipo_doc','in',('2', '3'))]}</attribute>
                </field>

                <xpath
                    expr="//field[@name='child_ids']//form//field[@name='name']"
                    position="before"
                >
                    <field
                        name="company_type"
                        options="{'horizontal': true}"
                        widget="radio"
                    />
                    <field name="tipo_doc" />
                    <field name="vat" string="Nro. Doc" />
                </xpath>

                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute
                        name="context"
                    >{'default_tipo_doc': tipo_doc, 'default_vat': vat, 'default_company_type': company_type}</attribute>
                </xpath>
            </field>
        </record>

        <record id="qapps_uy_base_res_partner_view_search" model="ir.ui.view">
            <field name="name">qapps.uy.base.res.partner.search.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter" />
            <field name="arch" type="xml">
                <search>
                    <field name="razon_social" string="Razón social" />
                    <field name="vat" string="Nro. Doc" />
                </search>
            </field>
        </record>

    </data>
</odoo>
