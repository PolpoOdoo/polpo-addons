<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_credit_authorizer" model="res.groups">
        <field name="name">Autorizador de crédito</field>
        <field name="category_id" ref="account_financial_risk.category_financial_risk" />
        <field
            name="implied_ids"
            eval="[(4, ref('account_financial_risk.group_account_financial_risk_user'))]"
        />
        <field name="comment">
            Puede autorizar operaciones bloqueadas por riesgo crediticio.
            La autorización queda registrada con usuario, fecha y motivo.
        </field>
    </record>

    <!-- Sin implied desde base.group_erp_manager: hay bases con usuarios
         operativos con Ajustes que heredarían la autorización de crédito.
         El grupo se asigna explícitamente por usuario, mismo criterio que
         Ver costos / Ver precios. No re-agregar el implied. -->

    <!-- Jerarquía de riesgo Usuario < Autorizador (Supervisor) < Gerente:
         el Gerente de Riesgo financiero (OCA) implica al Autorizador de crédito,
         de modo que quien puede editar la configuración de riesgo también puede
         autorizar excepciones. Cadena resultante:
           group_account_financial_risk_manager
             -> group_credit_authorizer
               -> group_account_financial_risk_user.
         Se extiende el grupo OCA sin modificar su módulo. -->
    <record
        id="account_financial_risk.group_account_financial_risk_manager"
        model="res.groups"
    >
        <field
            name="implied_ids"
            eval="[(4, ref('polpo_credit_risk.group_credit_authorizer'))]"
        />
    </record>
</odoo>
