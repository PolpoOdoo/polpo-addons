<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_credit_authorizer" model="res.groups">
        <field name="name">Autorizador de crédito</field>
        <field name="category_id" ref="account_financial_risk.category_financial_risk" />
        <field
            name="implied_ids"
            eval="[(4, ref('account_financial_risk.group_account_financial_risk_user'))]"
        />
        <field name="comment">
            Puede autorizar operaciones bloqueadas por riesgo crediticio.
            La autorización queda registrada con usuario, fecha y motivo.
        </field>
    </record>

    <!-- Sin implied desde base.group_erp_manager: en bases con usuarios
         operativos que tienen Ajustes, heredarían la autorización de
         crédito. El grupo se asigna explícitamente por usuario.
         No re-agregar el implied. -->
</odoo>
