<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="polpo_credit_override_wiz_form" model="ir.ui.view">
        <field name="name">polpo.credit.override.wiz.form</field>
        <field name="model">polpo.credit.override.wiz</field>
        <field name="arch" type="xml">
            <form string="Riesgo crediticio excedido">
                <div class="alert alert-warning mb-3" role="alert">
                    <h6 class="mb-2">
                        <i class="fa fa-exclamation-triangle me-1" />
                        Motivo del bloqueo
                    </h6>
                    <field name="exception_msg_html" nolabel="1" readonly="1" />
                </div>
                <separator string="Motivo de la autorización" invisible="not can_authorize" />
                <group invisible="not can_authorize">
                    <field
                        name="override_reason"
                        nolabel="1"
                        colspan="2"
                        placeholder="Ingrese el motivo de la autorización..."
                    />
                </group>
                <field name="partner_id" invisible="1" />
                <field name="origin_reference" invisible="1" />
                <field name="continue_method" invisible="1" />
                <field name="can_authorize" invisible="1" />
                <footer>
                    <button
                        name="button_authorize"
                        string="Autorizar y continuar"
                        type="object"
                        class="btn-primary"
                        groups="polpo_credit_risk.group_credit_authorizer"
                        invisible="not can_authorize"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
