<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="qapps_litnor_view_picking_form" model="ir.ui.view">
            <field name="name">stock.picking</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <label for="barcode" string="Código de barra" />
                    <p style="display: flex;">
                        <field name="barcode" />
                        <button
                            type="object"
                            name="wizard_barcode_reader_action"
                            class="btn btn-link"
                            icon="fa-search-plus"
                            string=""
                            title=""
                        />
                    </p>
                    <field
                        name="checked_order"
                        widget="boolean_toggle"
                        readonly="1"
                        force_save="1"
                    />
                </xpath>

                <xpath
                    expr="//field[@name='move_ids_without_package']/tree/field[@name='quantity']"
                    position="before">
                    <field name="qty_checked" />
                </xpath>

                <xpath expr="//field[@name='move_ids_without_package']/tree" position="attributes">
                    <attribute name="decoration-success">qty_checked == product_uom_qty</attribute>
                </xpath>
            </field>
        </record>

        <record id="qapps_litnor_stock_picking_vpicktree" model="ir.ui.view">
            <field name="name">stock.picking.tree</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field
                        name="checked_order"
                        optional="show"
                        widget="boolean_toggle"
                        readonly="state == 'done'"
                    />
                </xpath>
            </field>
        </record>

        <record id="qapps_litnor_stock_picking_search" model="ir.ui.view">
            <field name="name">stock.picking.search</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_internal_search" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='picking_type_id']" position="after">
                    <field name="checked_order" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
