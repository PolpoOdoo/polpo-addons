<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_exchange_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.exchange.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="15"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app string="Tasas de Cambios" name="current_rate_uy" data-string="Tasas de Cambios"
                         id="current_rate_uy">
                        <block title="General" name="general_config_current_rate_uy">
                            <setting id="currency_cotizacion_moneda"
                                     help="Activar la tarea programada.">
                                <field name="currency_cotizacion_moneda"/>
                            </setting>
                            <newline/>
                            <setting id="currency_cotizacion_moneda"
                                     help="Url del servicio de fecha de cierre."
                                     invisible="not currency_cotizacion_moneda">
                                <field name="currency_servicio_fecha_cierre"/>
                            </setting>
                            <setting id="currency_servicio_cotizacion"
                                     help="Url del servicio de cotizaciones."
                                     invisible="not currency_cotizacion_moneda">
                                <field name="currency_servicio_cotizacion"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="currency_rate_load_config_action" model="ir.actions.act_window">
            <field name="name">Tasas de cambio</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'current_rate_uy', 'bin_size': False}</field>
        </record>

    </data>
</odoo>