<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_notify_due_checks" model="ir.cron">
        <field name="name">Cheques en cartera: notificar vencimientos del día</field>
        <field name="model_id" ref="model_qapps_check_wallet" />
        <field name="state">code</field>
        <field name="code">model._cron_notify_due_checks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field
            name="nextcall"
            eval="(DateTime.now() + relativedelta(days=1, hour=10, minute=0, second=0, microsecond=0))"
        />
        <field name="active" eval="True" />
    </record>
</odoo>
