<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inline tree dentro del form de la boleta: muestra los cheques ya seleccionados -->
    <record id="account_check_deposit_view_form_qapps" model="ir.ui.view">
        <field name="name">account.check.deposit.form.qapps.check.wallet</field>
        <field name="model">account.check.deposit</field>
        <field name="inherit_id" ref="account_check_deposit.account_check_deposit_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='check_payment_ids']/tree/field[@name='date_maturity']"
                position="attributes">
                <attribute name="string">Vto. apunte</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath
                expr="//field[@name='check_payment_ids']/tree/field[@name='date_maturity']"
                position="before">
                <field name="vencimiento" string="Vto. cheque" optional="show" />
            </xpath>

            <xpath
                expr="//field[@name='check_payment_ids']/tree/field[@name='date_maturity']"
                position="after">
                <field name="numero_cheque" string="Número de cheque" optional="show" />
            </xpath>
        </field>
    </record>

    <!-- Vista list global de account.move.line: la que se abre en el modal "Agregar"
         del picker de cheques. Agregamos vencimiento y numero_cheque, forzamos
         date_maturity visible y hacemos move_name opcional (oculta por defecto). -->
    <record id="view_move_line_tree_qapps_check" model="ir.ui.view">
        <field name="name">account.move.line.tree.qapps.check.wallet</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_maturity']" position="attributes">
                <attribute name="string">Vto. apunte</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='date_maturity']" position="before">
                <field name="vencimiento" string="Vto. cheque" optional="show" />
            </xpath>

            <xpath expr="//field[@name='date_maturity']" position="after">
                <field name="numero_cheque" string="Número de cheque" optional="show" />
            </xpath>

            <xpath expr="//field[@name='move_name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vista search global de account.move.line: agregamos vencimiento y
         numero_cheque como campos buscables en la barra del modal. -->
    <record id="view_account_move_line_filter_qapps_check" model="ir.ui.view">
        <field name="name">account.move.line.search.qapps.check.wallet</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="vencimiento" string="Vto. cheque" />
                <field name="numero_cheque" string="Número de cheque" />
            </xpath>
        </field>
    </record>
</odoo>
