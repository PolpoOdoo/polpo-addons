<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="qapps_check_endorsement_view_form" model="ir.ui.view">
        <field name="name">qapps.check.endorsement.form</field>
        <field name="model">qapps.check.endorsement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_validate"
                        type="object"
                        string="Validar endoso"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_back_to_draft"
                        type="object"
                        string="Volver a borrador"
                        invisible="state != 'done'"
                        confirm="¿Seguro que desea volver el endoso a borrador? Se eliminará el asiento y los cheques volverán a la cartera."
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,done" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_move"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book"
                            invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver asiento</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label string="Endoso de cheques" for="name" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endorsement_date" readonly="state == 'done'" />
                            <field
                                name="partner_id"
                                readonly="state == 'done'"
                                options="{'no_create': True}"
                            />
                            <field
                                name="journal_id"
                                readonly="state == 'done'"
                                options="{'no_create': True}"
                            />
                            <field
                                name="currency_id"
                                groups="base.group_multi_currency"
                                readonly="state == 'done'"
                                options="{'no_open': True, 'no_create': True}"
                            />
                            <field name="currency_id" invisible="1" />
                            <field name="company_id" invisible="1" />
                        </group>
                        <group>
                            <field name="in_hand_check_account_id" />
                            <field name="check_count" />
                            <field name="total_check_amount" />
                            <field name="total_invoice_amount" />
                            <field name="move_id" invisible="not move_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Cheques a endosar" name="checks">
                            <field
                                name="check_payment_ids"
                                nolabel="1"
                                widget="many2many"
                                readonly="state == 'done'"
                                domain="[('reconciled', '=', False),
                                            ('debit', '>', 0),
                                            ('check_deposit_id', '=', False),
                                            ('check_endorsement_id', '=', False),
                                            ('check_collection_id', '=', False),
                                            ('currency_id', '=', currency_id),
                                            ('account_id', '=', in_hand_check_account_id),
                                            ('company_id', '=', company_id),
                                            ('parent_state', '=', 'posted')]"
                                context="{'currency': currency_id, 'journal_id': journal_id}">
                                <tree>
                                    <field name="date" />
                                    <field
                                        name="vencimiento"
                                        string="Vto. cheque"
                                        optional="show"
                                    />
                                    <field
                                        name="numero_cheque"
                                        string="Número de cheque"
                                        optional="show"
                                    />
                                    <field name="move_id" />
                                    <field name="ref" optional="show" />
                                    <field name="partner_id" />
                                    <field name="balance" sum="Total" optional="show" />
                                    <field
                                        name="amount_currency"
                                        groups="base.group_multi_currency"
                                        sum="Total moneda"
                                        optional="hide"
                                    />
                                    <field name="currency_id" invisible="1" />
                                    <field name="company_currency_id" invisible="1" />
                                </tree>
                            </field>
                        </page>
                        <page string="Facturas a saldar (opcional)" name="invoices">
                            <div class="alert alert-info" role="alert" invisible="invoice_ids">
                                Sin facturas seleccionadas, el endoso se registra como
                                <strong>pago a cuenta</strong>
                                del proveedor (saldo a favor a conciliar luego).
                            </div>
                            <field name="invoice_ids" nolabel="1" readonly="state == 'done'">
                                <tree>
                                    <field name="invoice_date" />
                                    <field name="name" />
                                    <field name="ref" optional="show" />
                                    <field name="invoice_date_due" optional="show" />
                                    <field name="amount_total" sum="Total" />
                                    <field
                                        name="amount_residual"
                                        string="Adeudado"
                                        sum="Adeudado"
                                    />
                                    <field name="currency_id" invisible="1" />
                                    <field name="payment_state" widget="badge" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="qapps_check_endorsement_view_tree" model="ir.ui.view">
        <field name="name">qapps.check.endorsement.tree</field>
        <field name="model">qapps.check.endorsement</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" decoration-bf="1" />
                <field name="endorsement_date" />
                <field name="partner_id" />
                <field name="journal_id" optional="show" />
                <field name="check_count" />
                <field name="total_check_amount" decoration-bf="1" />
                <field name="currency_id" groups="base.group_multi_currency" optional="show" />
                <field name="company_id" groups="base.group_multi_company" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                />
            </tree>
        </field>
    </record>

    <record id="qapps_check_endorsement_view_search" model="ir.ui.view">
        <field name="name">qapps.check.endorsement.search</field>
        <field name="model">qapps.check.endorsement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="journal_id" />
                <filter name="filter_draft" string="Borrador" domain="[('state', '=', 'draft')]" />
                <filter name="filter_done" string="Validados" domain="[('state', '=', 'done')]" />
                <separator />
                <filter name="filter_date" string="Fecha de endoso" date="endorsement_date" />
                <group string="Agrupar por" name="groupby">
                    <filter
                        name="groupby_partner"
                        string="Proveedor"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter name="groupby_state" string="Estado" context="{'group_by': 'state'}" />
                    <filter
                        name="groupby_date"
                        string="Fecha de endoso"
                        context="{'group_by': 'endorsement_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="qapps_check_endorsement_action" model="ir.actions.act_window">
        <field name="name">Endoso de cheques</field>
        <field name="res_model">qapps.check.endorsement</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="qapps_check_endorsement_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree un endoso de cheques</p>
            <p>
                Entregue cheques de la cartera a un proveedor para saldar sus facturas.
                Al validar, los cheques salen de la cartera y las facturas quedan conciliadas.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_qapps_check_endorsement"
        name="Endoso de cheques"
        parent="account.menu_finance_payables"
        action="qapps_check_endorsement_action"
        sequence="25"
    />
</odoo>
