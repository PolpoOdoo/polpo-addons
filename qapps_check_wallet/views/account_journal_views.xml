<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_qapps_check_wallet" model="ir.ui.view">
        <field name="name">account.journal.form.qapps.check.wallet</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='loss_account_id']" position="after">
                <field name="is_check_journal" invisible="type not in ('cash', 'bank')" />
            </xpath>
        </field>
    </record>
</odoo>
