<odoo>
    <data>
        <record id="res_config_settings_brou_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.brou.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="15"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app string="Tasas de Cambios BROU" name="brou_currency" data-string="Tasas de Cambios BROU"
                         id="brou_currency">
                        <block title="General" name="general_config_brou_currency">
                            <setting id="brou_currency_update"
                                     help="Activar la tarea programada para las tasas del BROU.">
                                <field name="brou_currency_update"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
