<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nace apagado: lo prende el booleano de Ajustes (res_config_settings.py busca el cron por este nombre). -->
    <record id="ir_cron_fetch_brou_rates" model="ir.cron">
        <field name="name">Actualizar tasas de cambio BROU</field>
        <field name="model_id" ref="base.model_res_currency_rate"/>
        <field name="state">code</field>
        <field name="code">model.fetch_brou_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
