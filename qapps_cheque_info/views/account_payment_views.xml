<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_account_payment_register_form_cheque" model="ir.ui.view">
        <field name="name">account.payment.register.form.cheque.info</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <field name="payment_date" position="after">
                <field name="numero_cheque" />
                <field name="vencimiento" />
                <field name="note" />
            </field>
        </field>
    </record>

    <record id="view_account_payment_form_cheque" model="ir.ui.view">
        <field name="name">account.payment.form.cheque.info</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="numero_cheque" />
                <field name="vencimiento" />
                <field name="note" />
            </field>
        </field>
    </record>

</odoo>
